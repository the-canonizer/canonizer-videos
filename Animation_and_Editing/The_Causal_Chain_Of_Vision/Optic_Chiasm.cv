    "text": {
     "value": {
      "overrides": [
       {
        "end": 304,
        "features": { "calt": 1, "clig": 1, "liga": 1 },
        "start": 0
       }
      ],
      "text": "One day, two of the officers and myself rode to Ribeira Grande, a village a few miles eastward of Porto Praya. Until we reached the valley of St. Martin, the country presented its usual dull brown appearance; but here, a very small rill of water produces a most refreshing margin of luxuriant vegetation."
     },
     "varType": "richText"
    },
    "textBoxSize": {
     "value": { "x": 1536.0, "y": 300.0 },
