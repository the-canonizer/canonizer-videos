  {
   "attributes": {
    "code": { "value": "uniform shader layer;\nconst half2 lightDirection = half2(1.0, 1.0);\n\nhalf4 main(float2 p) {\n    // Compute potential sampling positions\n    float2 pFwd = p + lightDirection;\n    float2 pBwd = p - lightDirection;\n\n    // Clamp the coordinates to the valid range\n    pFwd = clamp(pFwd, float2(- resolution * 0.5), resolution * 0.5 - 1.0);\n    pBwd = clamp(pBwd, float2(- resolution * 0.5), resolution * 0.5 - 1.0);\n\n    // Sample ahead and behind along the light direction\n    half4 sampleFwd = layer.eval(pFwd);\n    half4 sampleBwd = layer.eval(pBwd);\n\n    // Rough convertion to grayscale\n    half lumFwd = dot(sampleFwd.rgb, half3(0.299, 0.587, 0.114));\n    half lumBwd = dot(sampleBwd.rgb, half3(0.299, 0.587, 0.114));\n\n    // Compute difference, scale by intensity\n    half diff = (lumFwd - lumBwd) * intensity;\n\n    // Add a bias of 0.5 so the “midpoint” is gray\n    half embossLum = diff + 0.5;\n    embossLum = clamp(embossLum, 0.0, 1.0);\n    half3 embossColor = half3(embossLum);\n\n    half alpha = sampleFwd.a;\n    return half4(embossColor, alpha);\n}\n", "varType": "string" },
    "colorId": { "value": 14, "varType": "int" },
    "inputs": {
     "list": [
      { "instanceName": "intensity", "value": 1.0, "varType": "double" }
     ]
    },
    "niceName": { "value": "SkSL Filter", "varType": "string" },
    "uuid": { "value": "f9a53227-b7b3-4b25-92ce-6de55f99087a", "varType": "string" }
   },
   "nodeId": "skslFilter#1",
   "nodeType": "skslFilter"
  },
